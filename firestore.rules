rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Players collection
    // Authenticated users can read player profiles (for leaderboards, friend searches, requests)
    // Only the owner can write their own profile
    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(playerId);
      allow update: if isOwner(playerId);
      allow delete: if false;

      // Subcollection for levels if stored hierarchically
      match /levels/{levelId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(playerId);
      }
    }

    // Level progress collection
    match /level_progress/{progressId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.playerId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.playerId == request.auth.uid || request.resource.data.playerId == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.playerId == request.auth.uid;
    }

    // Friends collection
    match /friends/{friendDocId} {
      allow read: if isAuthenticated() && (resource.data.playerId == request.auth.uid || resource.data.friendId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.playerId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.playerId == request.auth.uid || resource.data.friendId == request.auth.uid);
    }

    // Friend requests
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid);
    }

    // Life requests
    match /life_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // Leaderboard entries
    match /leaderboard/{scoreId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.playerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.playerId == request.auth.uid;
      allow delete: if false;
    }
  }
}
